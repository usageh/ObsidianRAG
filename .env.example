# 复制为 .env 并填入实际值；.env 不进 git

# 大模型渠道 (AGICTO 中转, OpenAI 兼容格式)
AGICTO_API_KEY=你的key
LLM_BASE_URL=https://api.agicto.cn/v1/

# 各模型 id (可替换, 切正式版只改这里)
LLM_MODEL_CHAT=deepseek-v4-flash
LLM_MODEL_VISION=deepseek-v4-flash-vision-exp
LLM_MODEL_EMBEDDING=text-embedding-3-small

# Obsidian vault 路径 (含空格也能处理)
OBSIDIAN_VAULT=C:\Users\Yilia\Documents\Obsidian Vault

# 嵌入维度 (text-embedding-3-small 固定 1536, 换嵌入模型须重建向量库)
EMBEDDING_DIM=1536

# 去重语义相似度阈值
DEDUP_SIMILARITY_THRESHOLD=0.92

# RAG 检索: 低于此相似度视为不相关, 直接返回"未找到"
RAG_MIN_SIMILARITY=0.35
# RAG 检索召回片段数
RAG_TOP_K=5

# 主题聚类相似度阈值(>=此值归入同主题)
CLUSTER_SIMILARITY_THRESHOLD=0.55
# 形成主题的最少笔记数
CLUSTER_MIN_SIZE=2

# 薄弱主题判定阈值(掌握度低于此值视为薄弱)
WEAK_MASTERY_THRESHOLD=0.6

# 截图全局快捷键
SCREENSHOT_HOTKEY=ctrl+shift+s

# 运行时数据目录 (相对项目根, 不放 vault)
DATA_DIR=data
